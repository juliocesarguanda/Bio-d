{
  "name": "bio-d",
  "private": true,
  "version": "3.0.0",
  "main": "main.js",
  "type": "commonjs",
  "description": "Sitema de facturación e inventario de laboratorio clinico",
  "author": "Julio Guanda <juliocesarguanda@gmail.com> (https://github.com/juliocesarguanda/Bio-d)",
  "homepage": "https://github.com/juliocesarguanda/Bio-d",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliocesarguanda/Bio-d.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch . --exec \"electron .\"",
    "build": "electron-builder",
    "build:win": "electron-builder --win ",
    "build:linux": "electron-builder --linux "
  },
  "dependencies": {
    "axios": "^1.7.9",
    "buffer": "^6.0.3",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "detect-port": "^2.1.0",
    "dotenv": "^16.4.7",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.9",
    "eslint": "^9.21.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "fs-extra": "^9.1.0",
    "globals": "^16.0.0",
    "helmet": "^8.0.0",
    "moment": "^2.30.1",
    "mysql2": "^3.12.0",
    "nmap": "^1.1.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.0",
    "pdfkit": "^0.16.0",
    "pdfkit-table": "^0.1.99",
    "ping": "^0.4.4",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "asar": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "appId": "Bio-D",
    "productName": "Bio-D",
    "files": [
      "dev/**/*",
      "node_modules/**/*",
      "package.json",
      "main.js",
      "database.sqlite",
      "servicios/**/*",
      "utilidades/*"
    ],
    "directories": {
      "buildResources": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ],
      "icon": "dev/assets/img/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "dev/assets/img/png/logo.png",
      "maintainer": "juliocesarguanda@gmail.com",
      "vendor": "Bio-D"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "dev/assets/img/icon.ico"
    }
  },
  "keywords": [
    "bio",
    "electron",
    "desktop",
    "application"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "juliocesarguanda",
      "repo": "Bio-d"
    }
  ]
}
